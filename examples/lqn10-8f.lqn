# Header declaration
G
"lqn10-8f.lqn"
0.01
10000
1
0.5
-1

# Processors declaration, with multiplicity
P 0
p Proc0 f m 1000
p Proc1 f m 1000
p Proc2 f m 1000
p Proc3 f m 1000
p Proc4 f m 1000
p Proc5 f m 1000
p Proc6 f m 1000
p Proc7 f m 1000
-1

# Tasks declaration
T 0
t Task0 r Entr0 -1 Proc0 m 1
t Task1 n Entr1 -1 Proc1 m 1000
t Task2 n Entr2 -1 Proc2 m 1000
t Task3 n Entr3 -1 Proc3 m 1000
t Task4 n Entr4 -1 Proc4 m 1000
t Task5 n Entr5 -1 Proc5 m 1000
t Task6 n Entr6 -1 Proc6 m 1000
t Task7 n Entr7 -1 Proc7 m 1000
-1

# Entries declaration
E 0
A Entr0 acti0 
A Entr1 acti1 
A Entr2 acti2 
A Entr3 acti3 
A Entr4 acti4 
A Entr5 acti5 
A Entr6 acti6 
A Entr7 acti7 
-1

# Activities declaration
A Task0
s acti0 1.23 
s acti01 0.0001 
y acti01 Entr1 1
:
    acti0 -> acti01
-1

A Task1
s acti1 2.42
s acti12 0.0001 
s acti13 0.0001 
s acti15 0.0001 
s acti16 0.0001 
z acti12 Entr2 1
y acti13 Entr3 1
y acti15 Entr5 1
z acti16 Entr6 1
:
    acti1 -> (0.25)acti12 + (0.25)acti13 + (0.25)acti15 + (0.25)acti16;
    acti12[Entr1];
    acti13[Entr1];
    acti15[Entr1];
    acti16[Entr1]
-1

A Task2
s acti2 2.91
s acti24 0.0001 
s acti27 0.0001 
z acti24 Entr4 1
y acti27 Entr7 1
:
    acti2 -> (0.5)acti24 + (0.5)acti27;
    acti24;
    acti27
-1

A Task3
s acti3 0.3 
s acti37 0.0001 
y acti37 Entr7 1
:
    acti3 -> acti37;
    acti37[Entr3]
-1

A Task4
s acti4 2.94
s acti45 0.0001 
s acti46 0.0001 
y acti45 Entr5 1
z acti46 Entr6 1
:
    acti4 -> (0.5)acti45 + (0.5)acti46;
    acti45;
    acti46
-1

A Task5
s acti5 1.95 
s acti57 0.0001 
y acti57 Entr7 1
:
    acti5 -> acti57;
    acti57[Entr5]
-1

A Task6
s acti6 0.91
:
    acti6
-1

A Task7
