# Header declaration
G
"lqn02-5f.lqn"
0.01
10000
1
0.5
-1

# Processors declaration, with multiplicity
P 0
p Proc0 f m 1000
p Proc1 f m 1000
p Proc2 f m 1000
p Proc3 f m 1000
p Proc4 f m 1000
-1

# Tasks declaration
T 0
t Task0 r Entr0 -1 Proc0 m 1
t Task1 n Entr1 -1 Proc1 m 1000
t Task2 n Entr2 -1 Proc2 m 1000
t Task3 n Entr3 -1 Proc3 m 1000
t Task4 n Entr4 -1 Proc4 m 1000
-1

# Entries declaration
E 0
A Entr0 acti0 
A Entr1 acti1 
A Entr2 acti2 
A Entr3 acti3 
A Entr4 acti4 
-1

# Activities declaration
A Task0
s acti0 2.76 
s acti01 0.0001 
y acti01 Entr1 1
:
    acti0 -> acti01
-1

A Task1
s acti1 1.17
s acti12 0.0001 
s acti13 0.0001 
y acti12 Entr2 1
z acti13 Entr3 1
:
    acti1 -> (0.5)acti12 + (0.5)acti13;
    acti12[Entr1];
    acti13[Entr1]
-1

A Task2
s acti2 1.02 
s acti24 0.0001 
z acti24 Entr4 1
:
    acti2 -> acti24;
    acti24[Entr2]
-1

A Task3
s acti3 0.4
:
    acti3
-1

A Task4
s acti4 1.27
:
    acti4
-1

